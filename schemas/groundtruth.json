{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundtruth.json",
  "title": "groundtruth",
  "description": "Written by the attacker only, to the groundtruth volume the brain never mounts (plan section 7). Evaluation only.",
  "type": "object",
  "required": ["run_id", "persona", "objective", "steps"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^r-[0-9a-z_-]+$"},
    "persona": {"enum": ["crawler", "data_thief", "injector", "ai_recon", "victim"]},
    "objective": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "intent", "command"],
        "properties": {
          "t": {"type": "integer", "minimum": 0},
          "intent": {"type": "string"},
          "command": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
