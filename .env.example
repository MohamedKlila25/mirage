# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Region and models: this account (verified) is in us-west-2 and serves Claude through
# "us." inference profiles, not bare model ids.
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # strong: defender strategy, summaries, build mode
FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0       # cheap: triage, injection classifier, victim/attacker agents
EMBED_MODEL=amazon.titan-embed-text-v2:0

# Credentials.
#  - On an EC2 with an instance role: leave these unset (boto3 uses the role; no keys anywhere).
#  - Running locally / short-lived workshop credentials: set the three below (boto3 uses them
#    from the environment). They are temporary and expire; refresh from the event's AWS page.
#    Still never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
